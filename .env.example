# Local use only: copy to .env. On Render set these in Environment instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Origin only: no repository path and no trailing slash.
ALLOWED_ORIGINS=http://localhost:8000
# Choose a private phrase of at least 16 characters. Never commit its real value.
APP_ACCESS_TOKEN=
PORT=3000
MAX_REQUESTS_PER_HOUR=30
MAX_REQUESTS_PER_DAY=150
